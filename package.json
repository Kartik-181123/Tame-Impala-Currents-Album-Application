{
  "name": "currents-player",
  "private": true,
  "version": "1.0.0",
  "description": "Tame Impala - Currents Edition Desktop Music Player with Apple Music word-by-word synced lyrics",
  "main": "electron/main.js",
  "type": "module",
  "author": "Currents Edition",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder --win portable",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.tameimpala.currentsplayer",
    "productName": "Currents Music Player",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "Songs & Lyrics",
        "to": "Songs & Lyrics",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
